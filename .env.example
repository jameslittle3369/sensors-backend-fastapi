# Copy to .env for local dev, or set these as real environment variables
# in production (ansible-managed on rpi4-api, matching Django's
# convention of reading config from the environment, not a .env file).

DATABASE_URL=postgresql://api:CHANGE_ME@10.0.0.11/api
SECRET_KEY=CHANGE_ME

# Ingestion endpoint (POST /v1/tstats) -- moved out of hardcoded literals
# per the migration plan's small-improvement note.
OWSERVER_URL=http://10.0.0.188/details.xml
DYSON_HOST=10.0.0.17
DYSON_SERIAL=CHANGE_ME
DYSON_CREDENTIALS=CHANGE_ME
DYSON_PRODUCT_TYPE=CHANGE_ME
DYSON_NAME=CHANGE_ME
DYSON_VERSION=CHANGE_ME
